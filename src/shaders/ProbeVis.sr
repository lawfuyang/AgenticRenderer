// DDGI Probe Visualization — RayQuery compute shader binding set.
// Uses RayQuery (inline RT) to trace probe spheres and read irradiance/distance/state.
extern DDGIVolumeDescGPUPacked;

cbuffer ProbeVisConstants
{
    float4x4    m_MatViewToWorld;       // for camera-ray generation
    float4x4    m_MatWorldToClip;       // for depth-test projection
    float4x4    m_MatClipToWorld;       // for world-pos reconstruction (MatrixMultiply)
    float       m_TanHalfFovY;
    float       m_Aspect;
    uint        m_DebugMode;            // DDGIDebugMode value
    float       m_ViewportWidth;        // copy of m_ViewportSize.x (alignment fill)
    float2      m_ViewportSize;         // (width, height)
    float2      m_ViewportSizeInv;      // (1/width, 1/height)
    uint        m_IrradianceTexIndex;   // bindless SRV index of DDGI irradiance Texture2DArray
    uint        m_DistanceTexIndex;     // bindless SRV index of DDGI distance Texture2DArray 
    uint        m_ProbeDataTexIndex;    // bindless SRV index of DDGI probe-data Texture2DArray
};

srinput ProbeVisInputs
{
    ProbeVisConstants                       m_ProbeVisCB;

    RaytracingAccelerationStructure         ProbeTLAS;
    StructuredBuffer<DDGIVolumeDescGPUPacked>     DDGIVolumes;
    Texture2D<float>                        Depth;
    RWTexture2D<float4>                     OverlayOutput;
};
