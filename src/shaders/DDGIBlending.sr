// DDGI SDK blending passes binding set.
// The SDK shaders (ProbeBlendingCS, RelocationCS, ClassificationCS, ReductionCS)
// use RTXGI_DDGI_SHADER_REFLECTION=1 + RTXGI_BINDLESS_TYPE_DESCRIPTOR_HEAP, so all
// textures/buffers are fetched from the global ResourceDescriptorHeap by index.
// DDGIRootConstants is passed as a root/push constant (matches RTXGI D3D12 reference).

extern rtxgi::DDGIRootConstants;

cbuffer DDGIBlendingConsts
{
    rtxgi::DDGIRootConstants m_RootConstants;
};

srinput DDGIBlendingInputs
{
    [push_constant]
    DDGIBlendingConsts m_DDGIRootCB;
};
