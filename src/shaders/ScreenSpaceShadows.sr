#include "Common.sr"

cbuffer ScreenSpaceShadowConstants
{
    float4 m_LightCoordinate;       // xy = pixel coords of light, z = NDC depth of light, w = direction sign (+1 or -1)
    int2   m_WaveOffset;            // Per-dispatch wave offset (from BuildDispatchList)
    float2 m_InvDepthTextureSize;   // 1.0 / depth texture dimensions
    float  m_FarDepthValue;         // Depth buffer value at far plane (0 for reversed-Z)
    float  m_NearDepthValue;        // Depth buffer value at near plane (1 for reversed-Z)
    float  m_SurfaceThickness;      // Assumed pixel thickness as fraction of depth range (e.g. 0.005)
    float  m_BilinearThreshold;     // Edge detection threshold for bilinear filtering (e.g. 0.02)
    float  m_ShadowContrast;        // Contrast boost for shadow transition (e.g. 4.0)
    uint   m_Flags;                 // Packed booleans: bit0=IgnoreEdgePixels, bit1=UsePrecisionOffset, bit2=BilinearSamplingOffsetMode, bit3=UseEarlyOut
    float2 m_DepthBounds;           // Min/max depth for early-out culling
    float2 m_Padding;               // Alignment padding
};

srinput ScreenSpaceShadowInputs
{
    ScreenSpaceShadowConstants m_CB;

    Texture2D<float>   DepthTexture;    // t0 — scene depth (reversed-Z)
    RWTexture2D<float> OutputTexture;   // u0 — R8_UNORM output shadow buffer

    SamplerState       PointBorderSampler; // s0 — point, clamp-to-border (border = far depth)
};
