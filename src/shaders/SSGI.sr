#include "Common.sr"

cbuffer SSGIConstants
{
    PlanarViewConstants m_View;         // current frame (ClipToView / ViewToWorld / WorldToView / camera pos / viewport)
    float3              m_SunDirection;
    float               m_SunIntensity;
    uint                m_Frame;
    float               m_RayDistance;  // default 10
    float               m_Thickness;    // default 0.5, view-space depth tolerance in world units
    float               m_MaxRadiance;  // firefly clamp: max luminance accepted from a single ray
    uint                m_Steps;        // default 20
    uint                m_RefineSteps;  // default 5
};

srinput SSGIInputs
{
    SSGIConstants       m_SSGICB;

    Texture2D<float4>   GBufferAlbedo;
    Texture2D<float2>   GBufferNormals;     // oct-encoded world normal
    Texture2D<float2>   GBufferORM;         // r = roughness, g = metalness
    Texture2D<float4>   GBufferEmissive;
    Texture2D<float>    ShadowMask;         // R8_UNORM CSM shadow mask (white = lit)
    Texture2D<float>    Depth;
    Texture2D<float2>   MotionVectors;      // pixel units
    Texture2D<float4>   AccumDiffuse;       // previous frame denoised accum (rgb = GI, a = age)
    Texture2D<float4>   AccumSpecular;
    Texture2D<float4>   BlueNoise;          // CommonResources::BlueNoiseTexture (64x64 RG)
    SamplerState        LinearSampler;
    SamplerState        PointSampler;
};
// Atmosphere textures are accessed via bindless indices in srrhi::CommonConsts
// (BRUNETON_TRANSMITTANCE_TEXTURE / BRUNETON_SCATTERING_TEXTURE) — no extra bindings.
