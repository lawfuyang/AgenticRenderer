#include "Common.sr"

cbuffer SSGIComposeConstants
{
    PlanarViewConstants m_View;             // current frame
    float3              m_SunDirection;
    float               m_SunIntensity;
    uint                m_DebugMode;        // SSGIDebugMode enum value; 0 = off
};

srinput SSGIComposeInputs
{
    SSGIComposeConstants m_ComposeCB;

    Texture2D<float4>   DenoisedDiffuse;    // denoise output (rgb = GI, a = age)
    Texture2D<float4>   DenoisedSpecular;
    Texture2D<float4>   GBufferAlbedo;
    Texture2D<float2>   GBufferNormals;
    Texture2D<float2>   GBufferORM;
    Texture2D<float4>   GBufferEmissive;
    Texture2D<float>    ShadowMask;
    Texture2D<float>    Depth;

    // Debug-only taps into the intermediate stages (bound every frame, only read when m_DebugMode != 0)
    Texture2D<float4>   RawDiffuse;         // pass 1 output (rgb = GI or -1 sentinel, a = roughness)
    Texture2D<float4>   RawSpecular;        // pass 1 output (rgb = GI, a = ray length)
    Texture2D<float4>   TemporalDiffuse;    // pass 2 output (rgb = GI, a = age)
    Texture2D<float4>   TemporalSpecular;

    SamplerState        PointSampler;
};
