#include "Common.sr"

cbuffer SSGIDenoiseConstants
{
    PlanarViewConstants m_View;             // current frame
    uint                m_Frame;
    float               m_Radius;           // default 3
    float               m_Phi;              // default 0.5
    float               m_LumaPhi;          // default 5
    float               m_DepthPhi;         // default 2
    float               m_NormalPhi;        // default 50
    float               m_RoughnessPhi;     // default 50
    float               m_SpecularPhi;      // default 50
};

srinput SSGIDenoiseInputs
{
    SSGIDenoiseConstants m_DenoiseCB;

    Texture2D<float4>   InputDiffuse;       // temporal reproject output (rgb = GI, a = age)
    Texture2D<float4>   InputSpecular;
    Texture2D<float>    Depth;
    Texture2D<float2>   GBufferNormals;
    Texture2D<float2>   GBufferORM;
    Texture2D<float4>   BlueNoise;          // CommonResources::BlueNoiseTexture (64x64 RG)
    SamplerState        PointSampler;
};
