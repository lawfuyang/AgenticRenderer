#include "Common.sr"

cbuffer EVSMConvertConstants
{
    float m_VsmExponent;   // c — exponential warp factor
    uint  m_CascadeIndex;  // which array slice to write
};

srinput EVSMConvertInputs
{
    [push_constant]
    EVSMConvertConstants m_CB;

    Texture2DArray<float>    DepthMap;    // t0 — D32_FLOAT CSM depth array (read as float SRV)
    RWTexture2DArray<float4> EVSMMap;     // u0 — RGBA16_FLOAT output (mip 0 only)
};
